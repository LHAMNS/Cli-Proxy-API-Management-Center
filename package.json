{
  "name": "cli-proxy-api-cli",
  "version": "0.1.0",
  "description": "Command-line tool for managing the CLIProxyAPI backend (local-only).",
  "type": "module",
  "bin": {
    "cpa": "./dist/cpa"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "bun build src/cli/index.ts --target=bun --outfile dist/cpa.js",
    "build:bin": "bun build src/cli/index.ts --compile --outfile dist/cpa",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "cross-spawn": "^7.0.6",
    "open": "^10.1.0",
    "ora": "^8.1.1",
    "prompts": "^2.4.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/prompts": "^2.4.9",
    "bun-types": "^1.1.30",
    "typescript": "^5.9.3"
  }
}
